# Билд образа с Go
FROM golang:1.22 as builder

WORKDIR /app

# Копируем исходный код и зависимости
COPY . .
RUN go mod download && go mod verify

# Компиляция бинарника
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /app/storage ./cmd/storage

# Минимальный образ для запуска
FROM alpine:3.19

RUN apk add --no-cache tzdata

WORKDIR /opt

# Копируем бинарник
COPY --from=builder /app/storage /opt/storage
RUN chmod +x /opt/storage

# Запуск под некорневым пользователем
RUN adduser -D -u 888 nonroot && chown -R 888:888 .
USER 888
# Билд образа с Go
FROM golang:1.22 as builder

WORKDIR /app

# Копируем исходный код и зависимости
COPY . .
RUN go mod download && go mod verify

# Компиляция бинарника
RUN CGO_ENABLED=0 go build -ldflags "-s -w" -o /app/storage ./cmd/storage

# Минимальный образ для запуска
FROM alpine:3.19

RUN apk add --no-cache tzdata

WORKDIR /opt

# Копируем бинарник
COPY --from=builder /app/storage /opt/storage

# Права на запуск
RUN chmod +x ./storage

# Запуск под некорневым пользователем
RUN adduser -D -u 888 nonroot && chown -R 888:888 .
USER 888

EXPOSE 80

CMD ["/opt/storage"]
