# export $(grep -v '^#' .env | xargs)

# system
ENV_NAME=local
LOG_LEVEL=info
API_VERSION=1.0

# standard http client
STANDARD_HTTP_CLIENT_TIMEOUT=30s

# mysql
MYSQL_SERVER=mysql:3306
MYSQL_DBNAME=karma8
MYSQL_USER=root
MYSQL_PASSWORD=root

# redis
REDIS_ADDR=redis:6379
REDIS_TYPE=redis

# http server
SERVER_SWAGGER_ENABLED=true

# file-storage
FILE_STORAGE_SECRET=secret

#
# MinioStorages
#

MINIO_STORAGE_ACCESS_KEY=minioadmin
MINIO_STORAGE_SECRET_KEY=minioadmin
MINIO_STORAGE_BUCKET=storage

# storage1
MINIO_STORAGE_1_HOST=karma8-minio1

# storage2
MINIO_STORAGE_2_HOST=karma8-minio2

# storage3
MINIO_STORAGE_3_HOST=karma8-minio3

# storage4
MINIO_STORAGE_4_HOST=karma8-minio4

# storage5
MINIO_STORAGE_5_HOST=karma8-minio5

# storage6
MINIO_STORAGE_6_HOST=karma8-minio6

# storage7
MINIO_STORAGE_7_HOST=karma8-minio7

# storage8
MINIO_STORAGE_8_HOST=karma8-minio8

# storage9
MINIO_STORAGE_9_HOST=karma8-minio9

# storage10
MINIO_STORAGE_10_HOST=karma8-minio10
